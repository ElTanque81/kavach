# --- KAVACH configuration. Copy to .env and fill in. Never commit .env. ---

# Agent mode: sim (offline demo) | paper (live HSKSwap prices, no transactions) | live (real transactions)
MODE=sim
PORT=8787

# HSK Chain mainnet RPC
HSK_RPC_URL=https://mainnet.hsk.xyz

# Owner wallet: deploys the vault and is the only one who can withdraw. Needs a little HSK for gas.
DEPLOYER_PRIVATE_KEY=

# The agent's hot wallet (a separate, fresh wallet!). It can only trade inside the vault's rules.
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

# Filled in after deploying (or read automatically from contracts/deployments/hsk-mainnet.json)
KAVACH_VAULT=

# Optional: anyone can run the keeper bot with any wallet that has a little HSK for gas
KEEPER_PRIVATE_KEY=

# Optional LLM strategist + chat (the agent runs fully without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# ...or any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
